# Copie para .env.local e preencha com os dados do SEU projeto Supabase.
# NUNCA comite o .env.local.

# ── Supabase (público, pode ir pro front) ──────────────────────────────
# URL base do projeto: https://<SEU-REF>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon key do projeto
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# (opcional) URL das Edge Functions; se vazio, é derivada da URL acima + /functions/v1
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=

# ── Bunny Stream ───────────────────────────────────────────────────────
# ID da biblioteca (player de vídeo) — PÚBLICO
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
# Mesmo ID da biblioteca, usado no servidor (upload)
BUNNY_LIBRARY_ID=
# AccessKey da biblioteca — SECRETA, só no servidor, NUNCA com prefixo NEXT_PUBLIC
BUNNY_API_KEY=

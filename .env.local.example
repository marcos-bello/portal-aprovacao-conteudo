# Copie para .env.local e preencha com os dados do SEU projeto Supabase.
# NUNCA comite o .env.local.

# URL das Edge Functions: https://<SEU-REF>.supabase.co/functions/v1
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=

# anon key do projeto (pública, pode ir pro front)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ID da biblioteca do Bunny Stream (para o player de vídeo)
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
